# Database
DB_USER=postgres
DB_HOST=localhost
DB_NAME=herbloom_db
DB_PASSWORD=your_password_here
DB_PORT=5432

# Database sync mode: safe | alter | force
# safe = no schema changes (production default)
# alter = auto-migrate in development (NEVER use in production)
# force = drop and recreate tables (NEVER use in production)
DB_SYNC=safe

# JWT
JWT_SECRET=generate_a_long_random_string_here
JWT_EXPIRES_IN=7d

# Server
MAINTENANCE_MODE=false
NODE_ENV=development

# Email (Resend)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="HerBloom <onboarding@resend.dev>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Port
PORT=5000

# Max upload size in MB (default: 10)
MAX_UPLOAD_MB=10
